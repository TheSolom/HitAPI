{
    "name": "hitapi-monorepo",
    "version": "1.0.0",
    "description": "API Monitoring & Analytics Platform",
    "author": "TheSolom",
    "license": "MIT",
    "homepage": "https://github.com/TheSolom/HitAPI#readme",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TheSolom/HitAPI.git"
    },
    "bugs": {
        "url": "https://github.com/TheSolom/HitAPI/issues"
    },
    "type": "module",
    "workspaces": [
        "packages/**",
        "apps/*"
    ],
    "scripts": {
        "build:api": "npm run build --workspace=apps/api",
        "build:types": "npm run build --workspace=packages/types",
        "build:shared": "npm run build --workspace=packages/shared",
        "build:sdk:js": "npm run build --workspace=packages/sdk/js",
        "format": "prettier --write \"**/*.{ts,js,json,md}\"",
        "start:api": "npm run start --workspace=apps/api",
        "start:dev:api": "npm run start:dev --workspace=apps/api",
        "start:prod:api": "npm run start:prod --workspace=apps/api",
        "lint": "npm run lint --workspaces",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.2",
        "@types/request-ip": "^0.0.41",
        "@types/supertest": "^7.2.1",
        "@types/winston": "^2.4.4",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.3.0",
        "prettier": "3.9.6",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0"
    },
    "allowScripts": {
        "@scarf/scarf@1.4.0": true,
        "@swc/core@1.15.47": true,
        "argon2@0.44.0": true,
        "esbuild@0.25.12": true,
        "msgpackr-extract@3.0.4": true,
        "unrs-resolver@1.12.2": true
    }
}
