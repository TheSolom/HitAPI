{
    "name": "@hitapi/types",
    "version": "1.0.0",
    "description": "HitAPI types",
    "author": "TheSolom",
    "license": "MIT",
    "homepage": "https://github.com/TheSolom/HitAPI#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TheSolom/HitAPI.git"
    },
    "bugs": {
        "url": "https://github.com/TheSolom/HitAPI/issues"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",

        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "type-check": "tsc --noEmit",

        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\""
    },
    "dependencies": {
        "@hitapi/shared": "^1.0.0"
    }
}
