{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../../tsconfig.build.json",
    "compilerOptions": {
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "rootDir": "src",
        "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
        "types": ["node", "express"],
        "paths": {
            "@hitapi/shared": ["../shared/dist/index.d.ts"],
            "@hitapi/shared/enums": ["../shared/dist/enums/index.d.ts"],
            "@hitapi/shared/utils": ["../shared/dist/utils/index.d.ts"],
            "@hitapi/shared/*": ["../shared/dist/*"]
        }
    },
    "include": ["src"],
    "exclude": ["dist"],
    "references": [
        { "path": "../shared" }
    ]
}
